# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# Ambientes virtuais
.venv/
venv/
env/
ENV/

# Testes, lint e tipagem
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- Node (code/analysis/: package.json e o medidor web-benchmark.mjs) ----
node_modules/
test-results/
playwright-report/

# ---- Editores e sistema operacional ----
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Variaveis locais e chaves (ex.: labsuser.pem do AWS Academy) nunca vao para o repositorio
.env
*.pem

# ---- Saidas geradas pelo codigo (output/) ----
# Versionados: output/graficos/ (graficos da analise, citados em doc/analysis/comparacao.md)
# e as pastas vazias (.gitkeep). O resto e regeravel.
output/sequential/*.png
output/parallel/*.png
output/results/*.csv
output/results/*.log
output/results/*.txt
output/results/setup.running
# Medicoes da analise dos 3 cenarios (code/analysis/): regeraveis; o relatorio
# versionado fica em doc/analysis/.
output/results/analysis/
!output/sequential/.gitkeep
!output/parallel/.gitkeep
!output/results/.gitkeep

# ---- Datasets ----
# dataset/dataset-100 e versionado no git; dataset/dataset-2000 vai pelo Git LFS
# (ver .gitattributes). Nenhum dos dois e ignorado.
